---
import Logo from "./Logo.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { getLangFromUrl, useTranslations, localizePath } from "~/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const nav = [
  { key: "nav.research", href: "/research" },
  { key: "nav.technology", href: "/technology" },
  { key: "nav.markets", href: "/markets" },
  { key: "nav.about", href: "/about" },
  { key: "nav.careers", href: "/careers" },
] as const;

const currentPath = Astro.url.pathname;
const stripped = currentPath.replace(/^\/zh(?=\/|$)/, "") || "/";
---

<header
  class="sticky top-0 z-50 backdrop-blur-xl"
  style="background: color-mix(in oklab, var(--color-ink) 78%, transparent);"
>
  <div class="container-x flex h-16 items-center justify-between gap-8 border-b border-[var(--color-rule-ink)]">
    <Logo size="md" />

    <nav class="hidden lg:flex items-center gap-7" aria-label="Primary">
      {
        nav.map((item) => {
          const isActive =
            stripped === item.href || stripped.startsWith(item.href + "/");
          return (
            <a
              href={localizePath(item.href, lang)}
              class:list={[
                "relative font-sans text-[13px] tracking-tight transition-colors",
                isActive
                  ? "text-[var(--color-bone)]"
                  : "text-[var(--color-bone-dim)] hover:text-[var(--color-bone)]",
              ]}
            >
              {t(item.key)}
              {isActive && (
                <span
                  class="absolute -bottom-[21px] left-0 right-0 h-px"
                  style="background: linear-gradient(90deg, transparent, var(--color-signal), transparent);"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-5">
      <LangSwitcher />
      <a
        href={localizePath("/contact", lang)}
        class="hidden md:inline-flex items-center gap-2 rounded-full border border-[var(--color-rule-ink)] bg-[var(--color-ink-2)] px-4 py-1.5 font-mono text-[11px] tracking-[0.18em] uppercase text-[var(--color-bone)] hover:border-[var(--color-signal-2)] hover:text-[var(--color-signal-hi)] transition-all"
      >
        {t("nav.cta")}
        <span aria-hidden="true">→</span>
      </a>
      <button
        type="button"
        class="lg:hidden grid h-9 w-9 place-items-center rounded-md border border-[var(--color-rule-ink)] text-[var(--color-bone)]"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M0 3h14M0 7h14M0 11h14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile drawer */}
  <div
    class="lg:hidden hidden border-b border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]"
    data-menu-panel
  >
    <nav class="container-x py-4 flex flex-col gap-1" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={localizePath(item.href, lang)}
            class="py-2 font-sans text-base text-[var(--color-bone)] hover:text-[var(--color-signal-hi)] border-b border-[var(--color-rule-ink)] last:border-0"
          >
            {t(item.key)}
          </a>
        ))
      }
      <a
        href={localizePath("/contact", lang)}
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-full border border-[var(--color-signal-2)] px-4 py-2 font-mono text-xs tracking-[0.18em] uppercase text-[var(--color-bone)]"
      >
        {t("nav.cta")} →
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.querySelector("[data-menu-panel]");
  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      panel.classList.toggle("hidden");
    });
  }
</script>
