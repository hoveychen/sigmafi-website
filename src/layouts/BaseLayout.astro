---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import {
  getLangFromUrl,
  alternateLangPath,
  type Lang,
} from "~/i18n/ui";

interface Props {
  title: string;
  description: string;
  /** Page-specific OG image relative URL */
  ogImage?: string;
  /** Optional surface override for the main content (dark default). */
  surface?: "ink" | "paper";
}

const { title, description, ogImage = "/og-default.svg", surface = "ink" } =
  Astro.props;

const lang: Lang = getLangFromUrl(Astro.url);
const altLang: Lang = lang === "en" ? "zh" : "en";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://sigmafi.ai");
const altUrl = new URL(
  alternateLangPath(Astro.url, altLang),
  Astro.site ?? "https://sigmafi.ai",
);
const ogUrl = new URL(ogImage, Astro.site ?? "https://sigmafi.ai");

const titleWithBrand =
  title === "SigmaFi Research"
    ? "SigmaFi Research — Technology-driven multi-asset quantitative trading"
    : `${title} — SigmaFi Research`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"} class={surface === "paper" ? "surface-paper" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0612" />
    <title>{titleWithBrand}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang={lang} href={canonical.toString()} />
    <link rel="alternate" hreflang={altLang} href={altUrl.toString()} />
    <link rel="alternate" hreflang="x-default" href={(Astro.site ?? "https://sigmafi.ai/").toString()} />

    {/* Favicons */}
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SigmaFi Research" />
    <meta property="og:title" content={titleWithBrand} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogUrl.toString()} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={altLang === "zh" ? "zh_CN" : "en_US"} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleWithBrand} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.toString()} />

    {/* Fonts — Fraunces (display) + Geist + Geist Mono + Noto Sans SC */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
    />
  </head>
  <body
    class:list={[
      surface === "paper"
        ? "bg-[var(--color-paper)] text-[var(--color-ink)]"
        : "bg-[var(--color-ink)] text-[var(--color-bone)]",
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-[var(--color-signal)] focus:px-3 focus:py-1.5 focus:text-[var(--color-ink)]"
    >
      {lang === "zh" ? "跳到主内容" : "Skip to content"}
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* Scroll reveal */}
    <script>
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (els.length && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
