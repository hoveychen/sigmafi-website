---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";
import { localizePath } from "~/i18n/ui";

const lang = "zh" as const;

const layers = [
  {
    code: "L4",
    title: "研究界面",
    body:
      "围绕 CWS 构建的 notebook + IDE。研究员描述一个假设，harness 自动扫描文献、起草信号、排入向量化回测队列。",
    nodes: ["σ-shell", "Notebook", "策略 DSL", "Harness agent"],
  },
  {
    code: "L3",
    title: "计算与数据平面",
    body:
      "PB 级行情与另类数据湖、GPU + CPU 集群、确定性回测、容量感知调度。同一份存储同时支撑研究与实盘。",
    nodes: ["Tick 归档", "GPU 集群", "Replay 引擎", "Feature store"],
  },
  {
    code: "L2",
    title: "执行与风险",
    body:
      "内核旁路网络、自研交易所接入层、低延迟 OMS，以及一个独立运行的风险系统——按策略硬限额、全局熔断都在它手上。",
    nodes: ["Adapter", "OMS", "智能路由", "风险核心"],
  },
  {
    code: "L1",
    title: "可观测与重放",
    body:
      "所有外部交互按比特捕获。昨天整天的真实流量，可以在数分钟内对候选策略重放——我们因此敢上线。",
    nodes: ["Lineage", "Tracing", "比特级重放", "Audit"],
  },
];

const cws = [
  {
    h: "AI 编码与策略生成",
    p: "harness 化的 LLM agent 阅读最新文献、生成信号、写实现、跑单测、迭代。一年的量化体力活，被压缩成一周。",
  },
  {
    h: "ETL 与弹性算力",
    p: "对接交易所、数据厂商、另类数据源的持续抽取与归一化。GPU/CPU 调度按截止日期分配算力，而不是按团队。",
  },
  {
    h: "研究管线与强化学习",
    p: "强化学习不仅作用于策略，也作用于元系统自身：算力花在哪、哪个市场值得重审、哪条策略该退役。",
  },
];
---

<BaseLayout
  title="技术"
  description="CWS — Coding Workflow System。把 harness engineering、大语言模型与低延迟交易栈，从研究一路收敛到生产。"
>
  <PageHero
    eyebrow="§ 技术"
    meta="CWS · 基础设施 · 韧性"
    title={"会自己进化的<br/><span class=\"text-[var(--color-signal-hi)]\">研究引擎。</span>"}
    subtitle="CWS——Coding Workflow System——是我们的四层栈，从市场直觉一路走到成交订单。每一层都为复利而设计：研究反哺生产，生产反哺研究。"
  />

  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 01 — 论点</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          量化的瓶颈，
          <span class="text-[var(--color-signal-hi)]">不再是想法。</span>
        </h2>
      </div>
      <div class="lg:col-span-7 grid gap-6 md:grid-cols-2">
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          约束并不在于"想出假设"——好研究员加现代大语言模型，每天产出的假设远超任何团队的审阅能力。
          真正的瓶颈在那条闭环：干净的测试、合理的压力、公平的仓位、诚实的监控、优雅的退役。
        </p>
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal style="animation-delay: 80ms;">
          CWS 把这条闭环当作产品。我们工程的对象是这个系统本身，而不是上面跑的具体策略。
          策略来来去去，闭环却在持续复利。
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]">
    <div class="container-x py-20 md:py-28">
      <p class="eyebrow" data-reveal>§ 02 — CWS 的三重奏</p>
      <h2 class="display mt-4 text-display-lg max-w-3xl" data-reveal>
        三个引擎，
        <span class="text-[var(--color-signal-hi)]">一条反馈回路。</span>
      </h2>

      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-rule-ink)] md:grid-cols-3">
        {
          cws.map((c, i) => (
            <article class="bg-[var(--color-ink)] p-8" data-reveal style={`animation-delay: ${60 * i}ms`}>
              <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-signal-2)]">{String(i + 1).padStart(2, "0")} / 03</span>
              <h3 class="mt-4 font-display text-2xl font-medium text-[var(--color-bone)]">{c.h}</h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-bone-dim)]">{c.p}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 研究方法 */}
  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 03 — 研究方法</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          管线学会
          <span class="text-[var(--color-signal-hi)]">改写自己。</span>
        </h2>
      </div>
      <div class="lg:col-span-7 grid gap-6 md:grid-cols-2">
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          量化研究员先把一条策略要走的完整管线亲手搭出来——取数、清洗、特征、回测、定仓、执行。
          这条管线就是教学大纲。其中每一个能被清晰界定的子问题，都被建模成一个自包含模块：
          显式的 IO 契约、验收测试、自己的 settings 与 skill 注册表。
        </p>
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal style="animation-delay: 80ms;">
          一个 supervisor AI 持续观察这些模块在真实工作中产生的执行轨迹，
          从历史里挖盲点与被错过的捷径，然后向出问题的模块写补丁——改它的 settings、扩它的 skill。
          相同的任务在相同数据上以 ablation 方式复跑，
          只有当 Δ 越过噪声底线时，补丁才被接受上线。
        </p>
      </div>
    </div>

    {/* 4 步横向流程 */}
    <div class="relative mt-16">
      <svg
        class="pointer-events-none absolute inset-x-0 -bottom-8 h-24 w-full hidden md:block"
        viewBox="0 0 1000 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <marker id="loop-arrow-zh" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--color-signal-2)" />
          </marker>
        </defs>
        <path
          d="M 920 10 C 920 80, 600 95, 375 95 C 200 95, 180 80, 180 25"
          fill="none"
          stroke="var(--color-signal-2)"
          stroke-width="1.2"
          stroke-dasharray="5 5"
          marker-end="url(#loop-arrow-zh)"
          opacity="0.65"
        />
        <text x="500" y="78" text-anchor="middle" fill="var(--color-signal-2)" class="font-mono" font-size="11" letter-spacing="2">
          META-LOOP · SUPERVISOR 改写模块
        </text>
      </svg>

      <ol class="grid grid-cols-1 gap-4 md:grid-cols-4">
        {
          [
            {
              n: "01",
              t: "专家管线",
              d: "量化研究员亲手画出从想法到实盘的完整路径——这条管线就是 SigmaFi 真实出货的标准流程。",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  {[0, 1, 2, 3, 4].map((i) => (
                    <>
                      <rect x={6 + i * 22} y={12} width={16} height={16} rx={2} fill="none" stroke="var(--color-bone-dim)" stroke-width="1" />
                      {i < 4 && <line x1={22 + i * 22} y1={20} x2={28 + i * 22} y2={20} stroke="var(--color-bone-dim)" stroke-width="1" />}
                    </>
                  ))}
                </svg>
              ),
            },
            {
              n: "02",
              t: "模块化分解",
              d: "管线里每个能被清晰界定的子问题，都变成一个自包含模块：显式 IO、验收测试、自己的 settings 与 skill 注册表，可独立迭代。",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  {[0, 1, 2, 3].map((col) =>
                    [0, 1].map((row) => (
                      <rect
                        x={10 + col * 26}
                        y={6 + row * 18}
                        width={18}
                        height={12}
                        rx={2}
                        fill="none"
                        stroke="var(--color-signal-hi)"
                        stroke-width="1"
                        opacity={0.85}
                      />
                    )),
                  )}
                </svg>
              ),
            },
            {
              n: "03",
              t: "Supervisor AI",
              d: "元 agent 收集所有真实工作中产生的执行轨迹，挖失败模式与被错过的捷径，然后向出问题的模块写补丁——改它的 settings、扩它的 skill。",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  <circle cx={60} cy={20} r={9} fill="none" stroke="var(--color-signal-2)" stroke-width="1.2" />
                  <circle cx={60} cy={20} r={2.5} fill="var(--color-signal-hi)" />
                  {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
                    const a = (i * Math.PI) / 4;
                    const x1 = 60 + Math.cos(a) * 13;
                    const y1 = 20 + Math.sin(a) * 13;
                    const x2 = 60 + Math.cos(a) * 19;
                    const y2 = 20 + Math.sin(a) * 19;
                    return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="var(--color-signal-2)" stroke-width="1" opacity={0.6} />;
                  })}
                </svg>
              ),
            },
            {
              n: "04",
              t: "Ablation 复跑",
              d: "打了补丁的模块在相同数据上复跑同一任务，与基线轨迹做比特级对比。Δ 越过噪声底线才上线，否则丢弃。",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  <line x1={10} y1={32} x2={110} y2={32} stroke="var(--color-bone-dim)" stroke-width="0.6" />
                  <rect x={22} y={20} width={14} height={12} fill="var(--color-bone-dim)" opacity={0.5} />
                  <rect x={44} y={14} width={14} height={18} fill="var(--color-signal-hi)" opacity={0.85} />
                  <rect x={66} y={24} width={14} height={8} fill="var(--color-bone-dim)" opacity={0.5} />
                  <rect x={88} y={10} width={14} height={22} fill="var(--color-signal-hi)" opacity={0.85} />
                </svg>
              ),
            },
          ].map((s, i) => (
            <li
              class="relative rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-ink-2)] p-6"
              data-reveal
              style={`animation-delay: ${60 * i}ms`}
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-signal-2)]">STEP {s.n}</span>
                {i < 3 && (
                  <span aria-hidden="true" class="hidden md:inline text-[var(--color-signal-2)] font-mono text-sm">→</span>
                )}
              </div>
              <h3 class="mt-4 font-display text-lg font-medium text-[var(--color-bone)]">{s.t}</h3>
              <div class="mt-4">{s.svg}</div>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-bone-dim)]">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>

    {/* 指标卡 */}
    <div class="mt-20 md:mt-24 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        [
          { k: "自迭代模块数", v: "约 120", t: "横跨整条管线" },
          { k: "Ablation / 周", v: "约 800", t: "Supervisor 自发起" },
          { k: "补丁采纳率", v: "约 31%", t: "Δ 越过噪声底线" },
          { k: "想法 → 实盘", v: "6 天", t: "中位数，CWS 化之后" },
        ].map((s, i) => (
          <div class="rounded-xl border border-[var(--color-rule-ink)] bg-[var(--color-ink)] p-5" data-reveal style={`animation-delay: ${40 * i}ms`}>
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-muted-ink)]">{s.k}</p>
            <p class="mt-3 font-display text-2xl font-medium text-[var(--color-bone)] tabular-nums">{s.v}</p>
            <p class="mt-1 font-mono text-[10px] tracking-[0.14em] text-[var(--color-muted-ink)]">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-[var(--color-rule-ink)] container-x py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow" data-reveal>§ 04 — 架构</p>
      <h2 class="display mt-4 text-display-lg" data-reveal>
        四层架构，
        <span class="text-[var(--color-signal-hi)]">全部可比特级重放。</span>
      </h2>
      <p class="mt-6 text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
        从研究员敲下一个假设，到一笔订单到达交易所撮合引擎——四层架构，
        由同一支团队拥有，每晚都对当日真实流量进行端到端重放。
      </p>
    </div>

    <ol class="mt-14 space-y-px overflow-hidden rounded-2xl border border-[var(--color-rule-ink)]">
      {
        layers.map((l, i) => (
          <li
            class="grid grid-cols-1 gap-6 bg-[var(--color-ink-2)] p-7 md:grid-cols-12 md:items-center"
            data-reveal
            style={`animation-delay: ${60 * i}ms`}
          >
            <div class="md:col-span-2 flex items-center gap-3">
              <span class="inline-grid h-9 w-9 place-items-center rounded-lg border border-[var(--color-rule-ink)] bg-[var(--color-ink)] font-mono text-[12px] text-[var(--color-signal-hi)]">{l.code}</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-muted-ink)]">LAYER</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-display text-xl font-medium text-[var(--color-bone)]">{l.title}</h3>
            </div>
            <p class="md:col-span-4 text-sm leading-relaxed text-[var(--color-bone-dim)]">{l.body}</p>
            <ul class="md:col-span-2 flex flex-wrap gap-1.5 md:justify-end">
              {l.nodes.map((n) => (
                <li class="rounded-full border border-[var(--color-rule-ink)] px-2.5 py-1 font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-bone-dim)]">{n}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]">
    <div class="container-x py-20 md:py-28">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow" data-reveal>§ 05 — 工程</p>
          <h2 class="display mt-4 text-display-md" data-reveal>
            延迟是
            <span class="text-[var(--color-signal-hi)]">一项设计选择。</span>
          </h2>
          <p class="mt-6 text-[var(--color-bone-dim)] leading-relaxed max-w-md" data-reveal>
            我们曾在 Getco 的工程师把订单路径的每一纳秒都摆在台面上。
            慢路径用可读的 Rust，热路径用手调的 C++，再叠 FPGA offload——每一道权衡都是显式的。
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-2 gap-6 md:grid-cols-3">
          {
            [
              { k: "Tick-to-Trade", v: "< 200 μs", t: "内部热路径" },
              { k: "OMS p99", v: "< 1.2 ms", t: "跨区域" },
              { k: "Replay 吞吐", v: "> 1 Tb/h", t: "比特级" },
              { k: "回测 / 日", v: "约 4,000 次", t: "向量 + tick" },
              { k: "语言", v: "Rust · C++ · Py", t: "局部 Mojo" },
              { k: "区域", v: "HKG · TYO · NYC", t: "Active-active" },
            ].map((s, i) => (
              <div class="rounded-xl border border-[var(--color-rule-ink)] bg-[var(--color-ink)] p-5" data-reveal style={`animation-delay: ${40 * i}ms`}>
                <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-muted-ink)]">{s.k}</p>
                <p class="mt-3 font-display text-2xl font-medium text-[var(--color-bone)] tabular-nums">{s.v}</p>
                <p class="mt-1 font-mono text-[10px] tracking-[0.14em] text-[var(--color-muted-ink)]">{s.t}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 06 — 韧性</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          无聊的基础设施，
          <span class="text-[var(--color-signal-hi)]">平静的交易台。</span>
        </h2>
      </div>
      <ul class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          [
            { h: "确定性重放", p: "所有外部交互都按纳秒时戳完整捕获。昨天的真实交易日，可以在数分钟内对一个代码改动重放。" },
            { h: "Active-active 多区域", p: "香港是锚点，东京与纽约是镜像。容灾切换每周在低影响窗口演练。" },
            { h: "独立的风险", p: "风险核心跑在独立的基础设施、独立的发布节奏、独立的 oncall。任何策略都不能绕过它。" },
            { h: "默认审计", p: "订单世系、模型版本、数据版本与参数值，全部写入只追加的账本。" },
          ].map((r, i) => (
            <li class="rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-ink-2)] p-6" data-reveal style={`animation-delay: ${60 * i}ms`}>
              <h3 class="font-display text-lg font-medium text-[var(--color-bone)]">{r.h}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-bone-dim)]">{r.p}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container-x py-16 md:py-24 border-t border-[var(--color-rule-ink)]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 items-end">
      <h3 class="md:col-span-2 display text-display-md max-w-3xl">
        工程师把它造出来，
        <span class="text-[var(--color-signal-hi)]">工程师也应该来跑它。</span>
      </h3>
      <a
        href={localizePath("/careers", lang)}
        class="inline-flex items-center gap-3 self-start rounded-full border border-[var(--color-rule-ink)] px-6 py-3 font-mono text-[12px] tracking-[0.18em] uppercase text-[var(--color-bone)] hover:border-[var(--color-signal-2)] hover:text-[var(--color-signal-hi)] transition-colors"
      >
        在招职位
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
