---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";

const lang = "zh" as const;

const channels = [
  {
    tag: "交易合作",
    email: "trading@sigmafi.ai",
    body: "ETF 授权参与者、波动率对手方、主经纪商与场所联络——直达交易台。",
  },
  {
    tag: "资本对接",
    email: "ir@sigmafi.ai",
    body: "机构配置者、家族办公室、对我们研究产品感兴趣的潜在 LP。",
  },
  {
    tag: "工程招聘",
    email: "careers@sigmafi.ai",
    body: "覆盖工程、研究、交易与运营的在招职位。发简历，附一段你交付过什么的简短自述。",
  },
  {
    tag: "媒体与其他",
    email: "hello@sigmafi.ai",
    body: "媒体咨询、演讲邀请，以及一切不属于以上分类的事项。",
  },
];
---

<BaseLayout
  title="联系"
  description="联系 SigmaFi 交易台。交易合作、资本对接、工程招聘与一般咨询——直达通道，无过滤漏斗。"
>
  <PageHero
    eyebrow="§ 联系"
    meta="交易台 · 办公室 · 监管"
    title={"直达<br/><span class=\"text-[var(--color-signal-hi)]\">交易台。</span>"}
    subtitle="没有层层过滤的咨询漏斗。下方每个通道都直接抵达对应负责人的邮箱。我们的目标是两个工作日内回复。"
  />

  <section class="container-x py-20 md:py-28">
    <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-rule-ink)] md:grid-cols-2">
      {
        channels.map((c, i) => (
          <li class="group bg-[var(--color-ink-2)] p-8 transition-colors hover:bg-[var(--color-ink-3)]" data-reveal style={`animation-delay: ${60 * i}ms`}>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-signal-2)]">{c.tag}</span>
              <span class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-muted-ink)]">.{String(i + 1).padStart(2, "0")}</span>
            </div>
            <a
              href={`mailto:${c.email}`}
              class="mt-4 inline-flex items-baseline gap-2 font-display text-2xl font-medium text-[var(--color-bone)] hover:text-[var(--color-signal-hi)] transition-colors"
            >
              {c.email}
              <span aria-hidden="true" class="font-mono text-sm text-[var(--color-signal-2)]">→</span>
            </a>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-bone-dim)] max-w-md">{c.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]">
    <div class="container-x py-20 md:py-28">
      <p class="eyebrow" data-reveal>§ 办公室</p>
      <h2 class="display mt-4 text-display-lg max-w-3xl" data-reveal>
        以香港为锚，
        <span class="text-[var(--color-signal-hi)]">镜像站点在外。</span>
      </h2>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          [
            {
              k: "香港（总部）",
              addr: "香港特别行政区中环",
              note: "交易台 · 研究 · 风险与合规 · 运营。",
            },
            {
              k: "纽约",
              addr: "纽约下曼哈顿",
              note: "美国上市市场联络 · 美股期权与股票覆盖。",
            },
            {
              k: "深圳",
              addr: "中国深圳",
              note: "亚太工程 · 运营 · 跨境基础设施。",
            },
          ].map((o, i) => (
            <article class="rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-ink)] p-7" data-reveal style={`animation-delay: ${60 * i}ms`}>
              <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-signal-2)]">{o.k}</p>
              <p class="mt-4 font-display text-xl font-medium text-[var(--color-bone)]">{o.addr}</p>
              <p class="mt-3 text-sm text-[var(--color-bone-dim)] leading-relaxed">{o.note}</p>
            </article>
          ))
        }
      </div>

      <p class="mt-10 max-w-2xl font-mono text-[11px] leading-relaxed tracking-[0.14em] text-[var(--color-muted-ink)]">
        ↳ 详细办公地址将向已确认的合作方按需提供。
      </p>
    </div>
  </section>

  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 监管</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          合规是
          <span class="text-[var(--color-signal-hi)]">一项功能。</span>
        </h2>
      </div>
      <div class="lg:col-span-7 space-y-6">
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          SigmaFi Research 是一家总部位于香港的量化交易公司。我们正在向香港证券及期货事务监察委员会（SFC）
          申请 9 号（资产管理）牌照。
        </p>
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          在牌照获批之前，本网站及通过本网站获得的资料仅作信息说明之用。
          本网站上的任何内容均不构成销售要约、购买要约的招揽，或对任何证券、产品或服务的推荐。
        </p>
        <p class="font-mono text-[10px] leading-relaxed tracking-[0.14em] uppercase text-[var(--color-muted-ink)]" data-reveal>
          监管相关咨询请发送至 compliance@sigmafi.ai。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
