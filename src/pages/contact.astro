---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";

const lang = "en" as const;

const channels = [
  {
    tag: "Trading partnerships",
    email: "trading@sigmafi.ai",
    body: "ETF authorised participants, vol counterparties, prime brokerage and venue contacts — reach the desk directly.",
  },
  {
    tag: "Capital introductions",
    email: "ir@sigmafi.ai",
    body: "Institutional allocators, family offices and prospective LPs interested in our research products.",
  },
  {
    tag: "Engineering recruiting",
    email: "careers@sigmafi.ai",
    body: "Open roles across engineering, research, trading and operations. Send a CV and a note on what you've shipped.",
  },
  {
    tag: "Media & general",
    email: "hello@sigmafi.ai",
    body: "Press enquiries, speaking requests, and everything that doesn't fit one of the boxes above.",
  },
];
---

<BaseLayout
  title="Contact"
  description="Reach the SigmaFi desk. Trading partnerships, capital introductions, engineering recruiting and general enquiries — direct channels, no triage."
>
  <PageHero
    eyebrow="§ Contact"
    meta="Desk · Offices · Regulation"
    title={"Reach the<br/><span class=\"text-[var(--color-signal-hi)]\">desk directly.</span>"}
    subtitle="No triage funnels. Each channel below routes straight to a member of the team who owns that conversation. Expect a reply within two business days."
  />

  {/* Channels */}
  <section class="container-x py-20 md:py-28">
    <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-rule-ink)] md:grid-cols-2">
      {
        channels.map((c, i) => (
          <li class="group bg-[var(--color-ink-2)] p-8 transition-colors hover:bg-[var(--color-ink-3)]" data-reveal style={`animation-delay: ${60 * i}ms`}>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-signal-2)]">{c.tag}</span>
              <span class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-muted-ink)]">.{String(i + 1).padStart(2, "0")}</span>
            </div>
            <a
              href={`mailto:${c.email}`}
              class="mt-4 inline-flex items-baseline gap-2 font-display text-2xl font-medium text-[var(--color-bone)] hover:text-[var(--color-signal-hi)] transition-colors"
            >
              {c.email}
              <span aria-hidden="true" class="font-mono text-sm text-[var(--color-signal-2)]">→</span>
            </a>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-bone-dim)] max-w-md">{c.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* Offices */}
  <section class="border-y border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]">
    <div class="container-x py-20 md:py-28">
      <p class="eyebrow" data-reveal>§ Offices</p>
      <h2 class="display mt-4 text-display-lg max-w-3xl" data-reveal>
        Hong Kong anchor.
        <span class="text-[var(--color-signal-hi)]">Mirror sites elsewhere.</span>
      </h2>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          [
            {
              k: "Hong Kong (HQ)",
              addr: "Central, Hong Kong SAR",
              note: "Trading desk · research · risk & compliance · operations.",
            },
            {
              k: "New York",
              addr: "Lower Manhattan, NY",
              note: "Listed-market liaison · US options & equities coverage.",
            },
            {
              k: "Shenzhen",
              addr: "Shenzhen, China",
              note: "APAC engineering · ops · cross-border infrastructure.",
            },
          ].map((o, i) => (
            <article class="rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-ink)] p-7" data-reveal style={`animation-delay: ${60 * i}ms`}>
              <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-[var(--color-signal-2)]">{o.k}</p>
              <p class="mt-4 font-display text-xl font-medium text-[var(--color-bone)]">{o.addr}</p>
              <p class="mt-3 text-sm text-[var(--color-bone-dim)] leading-relaxed">{o.note}</p>
            </article>
          ))
        }
      </div>

      <p class="mt-10 max-w-2xl font-mono text-[11px] leading-relaxed tracking-[0.14em] text-[var(--color-muted-ink)]">
        ↳ Office addresses are made available to confirmed counterparties upon request.
      </p>
    </div>
  </section>

  {/* Regulatory */}
  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ Regulation</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          Compliance is
          <span class="text-[var(--color-signal-hi)]">a feature.</span>
        </h2>
      </div>
      <div class="lg:col-span-7 space-y-6">
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          SigmaFi Research is a Hong Kong-based quantitative trading firm. We
          are in the process of applying for a Type 9 (Asset Management) licence
          with the Securities and Futures Commission (SFC) of Hong Kong.
        </p>
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          Until the licence is granted, this website and the materials
          accessible through it are informational only. Nothing on this site
          constitutes an offer to sell, a solicitation of an offer to buy, or a
          recommendation of any security, product, or service.
        </p>
        <p class="font-mono text-[10px] leading-relaxed tracking-[0.14em] uppercase text-[var(--color-muted-ink)]" data-reveal>
          For regulatory enquiries, write to compliance@sigmafi.ai.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
