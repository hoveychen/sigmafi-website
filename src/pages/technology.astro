---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";
import { localizePath } from "~/i18n/ui";

const lang = "en" as const;

const layers = [
  {
    code: "L4",
    title: "Research surface",
    body:
      "A notebook-meets-IDE built around CWS. Researchers describe a hypothesis, the harness runs the literature scan, drafts the signal, and queues it for vector backtest.",
    nodes: ["σ-shell", "Notebook", "Strategy DSL", "Harness agents"],
  },
  {
    code: "L3",
    title: "Compute & data plane",
    body:
      "Petabyte-scale market and alt-data lake, GPU + CPU clusters, deterministic backtests, capacity-aware schedulers. The same store powers research and live trading.",
    nodes: ["Tick archive", "GPU cluster", "Replay engine", "Feature store"],
  },
  {
    code: "L2",
    title: "Execution & risk",
    body:
      "Kernel-bypass networking, custom exchange adapters, low-latency OMS, and an independent risk system with hard per-strategy limits and global kill-switches.",
    nodes: ["Adapters", "OMS", "Smart order router", "Risk core"],
  },
  {
    code: "L1",
    title: "Observability & replay",
    body:
      "Every order ever sent is captured bit-exactly. Production traffic can be replayed against a candidate strategy in milliseconds, so we ship with confidence.",
    nodes: ["Lineage", "Tracing", "Bit-exact replay", "Audit"],
  },
];

const cws = [
  {
    h: "AI coding & strategy generation",
    p: "Harness-engineered LLM agents read the latest literature, propose signals, write the implementation, run the unit tests and iterate. A quant year becomes a quant week.",
  },
  {
    h: "ETL & elastic compute",
    p: "Continuous extraction and normalisation across exchanges, vendors and alt-data feeds. GPU/CPU schedulers allocate capacity by deadline, not by team.",
  },
  {
    h: "Research pipeline & RL",
    p: "Reinforcement-learning loops compound returns of the meta-system itself: which signals to spend compute on, which markets deserve a re-look, when to retire a strategy.",
  },
];
---

<BaseLayout
  title="Technology"
  description="CWS — the Coding Workflow System. Harness engineering, LLMs and a low-latency trading stack, sharing the same substrate from research to production."
>
  <PageHero
    eyebrow="§ Technology"
    meta="CWS · Infrastructure · Resilience"
    title={"A research engine<br/><span class=\"text-[var(--color-signal-hi)]\">that writes itself.</span>"}
    subtitle="CWS — Coding Workflow System — is our four-layer stack for taking a market intuition all the way to executed orders. Every layer is engineered to compound: research feeds production, production feeds research."
  />

  {/* Thesis */}
  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 01 — Thesis</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          The bottleneck of quant
          <span class="text-[var(--color-signal-hi)]">is no longer ideas.</span>
        </h2>
      </div>
      <div class="lg:col-span-7 grid gap-6 md:grid-cols-2">
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          The constraint isn't generating hypotheses — strong researchers and
          modern LLMs produce more than any desk can vet. The bottleneck is the
          loop: cleanly tested, properly stressed, fairly sized, honestly
          monitored, and gracefully retired.
        </p>
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal style="animation-delay: 80ms;">
          CWS treats that loop as the product. The system itself is what we
          engineer, not the individual strategies that live on top. Strategies
          come and go. The loop compounds.
        </p>
      </div>
    </div>
  </section>

  {/* CWS triad */}
  <section class="border-y border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]">
    <div class="container-x py-20 md:py-28">
      <p class="eyebrow" data-reveal>§ 02 — CWS in three movements</p>
      <h2 class="display mt-4 text-display-lg max-w-3xl" data-reveal>
        Three engines.
        <span class="text-[var(--color-signal-hi)]">One feedback loop.</span>
      </h2>

      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-rule-ink)] md:grid-cols-3">
        {
          cws.map((c, i) => (
            <article class="bg-[var(--color-ink)] p-8" data-reveal style={`animation-delay: ${60 * i}ms`}>
              <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-signal-2)]">{String(i + 1).padStart(2, "0")} / 03</span>
              <h3 class="mt-4 font-display text-2xl font-medium text-[var(--color-bone)]">{c.h}</h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-bone-dim)]">{c.p}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Research method */}
  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 03 — Research method</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          The pipeline learns
          <span class="text-[var(--color-signal-hi)]">to rewrite itself.</span>
        </h2>
      </div>
      <div class="lg:col-span-7 grid gap-6 md:grid-cols-2">
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
          Our quants hand-build the canonical pipeline a strategy travels —
          ingest, clean, feature, backtest, size, execute. That pipeline is
          the syllabus. Every well-defined sub-problem inside it becomes a
          self-contained module with explicit inputs, outputs, and acceptance
          tests.
        </p>
        <p class="text-[var(--color-bone-dim)] leading-relaxed" data-reveal style="animation-delay: 80ms;">
          A supervisor AI watches every execution trace those modules
          generate in real work, mines the history for blind spots and missed
          shortcuts, and proposes patches to the offending module's settings
          and skill registry. The same task is then re-run as an ablation;
          the patch ships only if Δ clears the noise floor.
        </p>
      </div>
    </div>

    {/* 4-step horizontal flow */}
    <div class="relative mt-16">
      {/* meta-loop SVG overlay */}
      <svg
        class="pointer-events-none absolute inset-x-0 -bottom-8 h-24 w-full hidden md:block"
        viewBox="0 0 1000 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <marker id="loop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--color-signal-2)" />
          </marker>
        </defs>
        <path
          d="M 920 10 C 920 80, 600 95, 375 95 C 200 95, 180 80, 180 25"
          fill="none"
          stroke="var(--color-signal-2)"
          stroke-width="1.2"
          stroke-dasharray="5 5"
          marker-end="url(#loop-arrow)"
          opacity="0.65"
        />
        <text x="500" y="78" text-anchor="middle" fill="var(--color-signal-2)" class="font-mono" font-size="11" letter-spacing="2">
          META-LOOP · SUPERVISOR REWRITES MODULES
        </text>
      </svg>

      <ol class="grid grid-cols-1 gap-4 md:grid-cols-4">
        {
          [
            {
              n: "01",
              t: "Expert pipeline",
              d: "Quants hand-build the canonical journey a strategy takes from idea to live order. It encodes how we already ship at SigmaFi.",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  {[0, 1, 2, 3, 4].map((i) => (
                    <>
                      <rect x={6 + i * 22} y={12} width={16} height={16} rx={2} fill="none" stroke="var(--color-bone-dim)" stroke-width="1" />
                      {i < 4 && <line x1={22 + i * 22} y1={20} x2={28 + i * 22} y2={20} stroke="var(--color-bone-dim)" stroke-width="1" />}
                    </>
                  ))}
                </svg>
              ),
            },
            {
              n: "02",
              t: "Modular decomposition",
              d: "Each well-defined sub-problem becomes a self-contained module: explicit IO contract, acceptance tests, settings, skill registry. Independently iterable.",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  {[0, 1, 2, 3].map((col) =>
                    [0, 1].map((row) => (
                      <rect
                        x={10 + col * 26}
                        y={6 + row * 18}
                        width={18}
                        height={12}
                        rx={2}
                        fill="none"
                        stroke="var(--color-signal-hi)"
                        stroke-width="1"
                        opacity={0.85}
                      />
                    )),
                  )}
                </svg>
              ),
            },
            {
              n: "03",
              t: "Supervisor AI",
              d: "A meta-agent ingests every execution trace from real work, mines them for failure patterns, and writes patches to the offending module's settings and skills.",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  <circle cx={60} cy={20} r={9} fill="none" stroke="var(--color-signal-2)" stroke-width="1.2" />
                  <circle cx={60} cy={20} r={2.5} fill="var(--color-signal-hi)" />
                  {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
                    const a = (i * Math.PI) / 4;
                    const x1 = 60 + Math.cos(a) * 13;
                    const y1 = 20 + Math.sin(a) * 13;
                    const x2 = 60 + Math.cos(a) * 19;
                    const y2 = 20 + Math.sin(a) * 19;
                    return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="var(--color-signal-2)" stroke-width="1" opacity={0.6} />;
                  })}
                </svg>
              ),
            },
            {
              n: "04",
              t: "Ablation re-run",
              d: "The patched module reruns the exact same task on the exact same data. We compare bit-exactly to the baseline. Ship only if Δ clears noise; reject otherwise.",
              svg: (
                <svg viewBox="0 0 120 40" class="w-full h-12">
                  <line x1={10} y1={32} x2={110} y2={32} stroke="var(--color-bone-dim)" stroke-width="0.6" />
                  <rect x={22} y={20} width={14} height={12} fill="var(--color-bone-dim)" opacity={0.5} />
                  <rect x={44} y={14} width={14} height={18} fill="var(--color-signal-hi)" opacity={0.85} />
                  <rect x={66} y={24} width={14} height={8} fill="var(--color-bone-dim)" opacity={0.5} />
                  <rect x={88} y={10} width={14} height={22} fill="var(--color-signal-hi)" opacity={0.85} />
                </svg>
              ),
            },
          ].map((s, i) => (
            <li
              class="relative rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-ink-2)] p-6"
              data-reveal
              style={`animation-delay: ${60 * i}ms`}
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] tracking-[0.22em] text-[var(--color-signal-2)]">STEP {s.n}</span>
                {i < 3 && (
                  <span aria-hidden="true" class="hidden md:inline text-[var(--color-signal-2)] font-mono text-sm">→</span>
                )}
              </div>
              <h3 class="mt-4 font-display text-lg font-medium text-[var(--color-bone)]">{s.t}</h3>
              <div class="mt-4">{s.svg}</div>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-bone-dim)]">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>

    {/* metrics row */}
    <div class="mt-20 md:mt-24 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        [
          { k: "Self-improving modules", v: "~ 120", t: "across the pipeline" },
          { k: "Ablations / week", v: "~ 800", t: "supervisor-initiated" },
          { k: "Patch acceptance", v: "~ 31%", t: "Δ clears noise floor" },
          { k: "Idea → live", v: "6 days", t: "median, since adopting CWS" },
        ].map((s, i) => (
          <div class="rounded-xl border border-[var(--color-rule-ink)] bg-[var(--color-ink)] p-5" data-reveal style={`animation-delay: ${40 * i}ms`}>
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-muted-ink)]">{s.k}</p>
            <p class="mt-3 font-display text-2xl font-medium text-[var(--color-bone)] tabular-nums">{s.v}</p>
            <p class="mt-1 font-mono text-[10px] tracking-[0.14em] text-[var(--color-muted-ink)]">{s.t}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Architecture */}
  <section class="border-t border-[var(--color-rule-ink)] container-x py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow" data-reveal>§ 04 — Architecture</p>
      <h2 class="display mt-4 text-display-lg" data-reveal>
        Four layers,
        <span class="text-[var(--color-signal-hi)]">all bit-exactly replayable.</span>
      </h2>
      <p class="mt-6 text-[var(--color-bone-dim)] leading-relaxed" data-reveal>
        From a researcher typing a hypothesis to an order hitting an exchange's
        matching engine — four layers, owned by one team, replayed end-to-end
        every night against the day's traffic.
      </p>
    </div>

    <ol class="mt-14 space-y-px overflow-hidden rounded-2xl border border-[var(--color-rule-ink)]">
      {
        layers.map((l, i) => (
          <li
            class="grid grid-cols-1 gap-6 bg-[var(--color-ink-2)] p-7 md:grid-cols-12 md:items-center"
            data-reveal
            style={`animation-delay: ${60 * i}ms`}
          >
            <div class="md:col-span-2 flex items-center gap-3">
              <span class="inline-grid h-9 w-9 place-items-center rounded-lg border border-[var(--color-rule-ink)] bg-[var(--color-ink)] font-mono text-[12px] text-[var(--color-signal-hi)]">
                {l.code}
              </span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-muted-ink)]">LAYER</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-display text-xl font-medium text-[var(--color-bone)]">{l.title}</h3>
            </div>
            <p class="md:col-span-4 text-sm leading-relaxed text-[var(--color-bone-dim)]">
              {l.body}
            </p>
            <ul class="md:col-span-2 flex flex-wrap gap-1.5 md:justify-end">
              {l.nodes.map((n) => (
                <li class="rounded-full border border-[var(--color-rule-ink)] px-2.5 py-1 font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-bone-dim)]">{n}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  {/* Latency / engineering */}
  <section class="border-y border-[var(--color-rule-ink)] bg-[var(--color-ink-2)]">
    <div class="container-x py-20 md:py-28">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow" data-reveal>§ 05 — Engineering</p>
          <h2 class="display mt-4 text-display-md" data-reveal>
            Latency is a
            <span class="text-[var(--color-signal-hi)]">design choice.</span>
          </h2>
          <p class="mt-6 text-[var(--color-bone-dim)] leading-relaxed max-w-md" data-reveal>
            Our former Getco engineers designed the order path to be honest
            about every nanosecond. We make the trade-offs explicit:
            human-readable Rust for the slow path, hand-tuned C++ and FPGA
            offload for the hot loop.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-2 gap-6 md:grid-cols-3">
          {
            [
              { k: "Tick-to-trade", v: "< 200 μs", t: "internal hot path" },
              { k: "OMS p99", v: "< 1.2 ms", t: "across regions" },
              { k: "Replay throughput", v: "> 1 Tb/h", t: "bit-exact" },
              { k: "Backtests / day", v: "~ 4,000", t: "vector + tick" },
              { k: "Languages", v: "Rust · C++ · Py", t: "ad-hoc Mojo" },
              { k: "Regions", v: "HKG · TYO · NYC", t: "active-active" },
            ].map((s, i) => (
              <div class="rounded-xl border border-[var(--color-rule-ink)] bg-[var(--color-ink)] p-5" data-reveal style={`animation-delay: ${40 * i}ms`}>
                <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-muted-ink)]">{s.k}</p>
                <p class="mt-3 font-display text-2xl font-medium text-[var(--color-bone)] tabular-nums">{s.v}</p>
                <p class="mt-1 font-mono text-[10px] tracking-[0.14em] text-[var(--color-muted-ink)]">{s.t}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* Resilience */}
  <section class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>§ 06 — Resilience</p>
        <h2 class="display mt-4 text-display-md" data-reveal>
          Boring infrastructure.
          <span class="text-[var(--color-signal-hi)]">Calm desks.</span>
        </h2>
      </div>
      <ul class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          [
            { h: "Deterministic replay", p: "Every external interaction is captured with nanosecond timestamps. Yesterday's full trading day can be replayed against a code change in minutes." },
            { h: "Active-active regions", p: "Hong Kong is anchor, Tokyo and New York are mirror sites. Failover is exercised weekly during low-impact windows." },
            { h: "Independent risk", p: "Risk core runs on its own infrastructure, its own deploy cadence, its own oncall. No strategy ever bypasses it." },
            { h: "Audit by default", p: "Order lineage, model versions, data versions and parameter values are all written to an append-only ledger." },
          ].map((r, i) => (
            <li class="rounded-2xl border border-[var(--color-rule-ink)] bg-[var(--color-ink-2)] p-6" data-reveal style={`animation-delay: ${60 * i}ms`}>
              <h3 class="font-display text-lg font-medium text-[var(--color-bone)]">{r.h}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-bone-dim)]">{r.p}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* CTA */}
  <section class="container-x py-16 md:py-24 border-t border-[var(--color-rule-ink)]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 items-end">
      <h3 class="md:col-span-2 display text-display-md max-w-3xl">
        Engineers built this.
        <span class="text-[var(--color-signal-hi)]">Engineers should run it.</span>
      </h3>
      <a
        href={localizePath("/careers", lang)}
        class="inline-flex items-center gap-3 self-start rounded-full border border-[var(--color-rule-ink)] px-6 py-3 font-mono text-[12px] tracking-[0.18em] uppercase text-[var(--color-bone)] hover:border-[var(--color-signal-2)] hover:text-[var(--color-signal-hi)] transition-colors"
      >
        Open roles
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
